# Where notes, attachments and the SQLite database are stored.
SCHRIFT_DATA_DIR=data
# Public URL, used for links in CalDAV tasks and OAuth redirects.
SCHRIFT_BASE_URL=http://localhost:8000
# Long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCHRIFT_SECRET_KEY=change-me
